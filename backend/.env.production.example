# ==========================================
# Garro Backend Production Environment (.env)
# ==========================================

NODE_ENV=production
PORT=5000

# MongoDB Production Connection String
MONGO_URI=mongodb://127.0.0.1:27017/garro_db
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/garro_db?retryWrites=true&w=majority

# Security Keys (Generate strong 64-char random strings in production)
JWT_SECRET=your_super_secret_jwt_key_must_be_long_and_random_string_here
JWT_EXPIRES_IN=7d

# CORS & Domain Whitelist
FRONTEND_URL=https://garro.ae
ALLOWED_ORIGINS=https://garro.ae,https://admin.garro.ae,https://garage.garro.ae

# Cloudflare R2 / AWS S3 Object Storage Credentials (for PDF Invoices & Uploaded Documents)
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_BUCKET_NAME=garro-uploads
R2_PUBLIC_URL=https://pub-yourhash.r2.dev

# Stripe Payment Gateway Production Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_live_webhook_secret

# Resend / SendGrid Email Notifications
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=notifications@garro.ae

# Twilio SMS / WhatsApp Notifications (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Google Gemini AI Key for Auto-Assign and Recommendations
GEMINI_API_KEY=your_google_gemini_api_key
