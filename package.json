{
  "name": "garro-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm --prefix backend start",
    "build": "npm --prefix frontend install && npm --prefix frontend run build && npm --prefix backend install",
    "seed": "npm --prefix backend run seed"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
